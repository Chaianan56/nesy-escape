{
  "id": "natural-commands-pilot-v2",
  "case": "A",
  "description": "หกกรณีแยกอิสระ ตั้งสถานะก่อนแต่ละข้อจาก walkthrough; ไม่ใช่เล่นหกคำสั่งต่อกัน",
  "cases": [
    {
      "id": "blackout_direct",
      "text": "คุณอยู่ที่ไหนตอนไฟดับ",
      "expected_command": {
        "action": "interrogate",
        "target": "gideon_hart",
        "topic": "blackout"
      },
      "expected_allowed": true,
      "before_command": {
        "action": "interrogate",
        "target": "gideon_hart",
        "topic": "account"
      }
    },
    {
      "id": "blackout_paraphrase",
      "text": "ช่วงไฟดับคุณอยู่ตรงไหนครับ",
      "expected_command": {
        "action": "interrogate",
        "target": "gideon_hart",
        "topic": "blackout"
      },
      "expected_allowed": true,
      "before_command": {
        "action": "interrogate",
        "target": "gideon_hart",
        "topic": "account"
      }
    },
    {
      "id": "door_without_key",
      "text": "เปิดประตูห้องระบบไฟให้หน่อย",
      "remove_inventory": [
        "staff_key"
      ],
      "expected_command": {
        "action": "unlock",
        "target": "electrical_room_door"
      },
      "expected_allowed": false,
      "before_command": {
        "action": "unlock",
        "target": "electrical_room_door"
      }
    },
    {
      "id": "door_with_key",
      "text": "เปิดประตูห้องระบบไฟให้หน่อย",
      "expected_command": {
        "action": "unlock",
        "target": "electrical_room_door"
      },
      "expected_allowed": true,
      "before_command": {
        "action": "unlock",
        "target": "electrical_room_door"
      }
    },
    {
      "id": "unlock_bag_only",
      "text": "เปิดกระเป๋าสำนวนด้วยรหัส 1923",
      "expected_command": {
        "action": "unlock",
        "target": "dossier_bag",
        "code": "1923"
      },
      "expected_allowed": true,
      "before_command": {
        "action": "unlock",
        "target": "dossier_bag"
      }
    },
    {
      "id": "inspect_document",
      "text": "ขอตรวจหนังสือนำส่งสำนวนในกระเป๋าหน่อย",
      "expected_command": {
        "action": "examine",
        "target": "judicial_transfer_order"
      },
      "expected_allowed": true,
      "before_command": {
        "action": "examine",
        "target": "judicial_transfer_order"
      }
    }
  ]
}
