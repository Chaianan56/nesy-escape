.venv/
.env
__pycache__/
*.pyc
.pytest_cache/

# logs/ เป็นที่ทิ้งของชั่วคราวจากการเล่นทดสอบ ไม่ต้องเก็บ
# ยกเว้น llm_cache.json ซึ่งคือโควตา LLM ที่จ่ายไปแล้ว ถ้าหายต้องรออีกวันจึงจะสร้างใหม่ได้
logs/*
!logs/llm_cache.json

# ผลการทดลองที่ต้องอ้างอิงในงานให้ย้ายมาไว้ที่ results/ ซึ่งเก็บลง git
logs/
