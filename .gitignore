.venv/
.env
__pycache__/
*.pyc
.pytest_cache/

# logs/ เป็นที่ทิ้งของชั่วคราวจากการเล่นทดสอบและ cache ของ LLM ไม่ต้องเก็บลง git
# เคยยกเว้น llm_cache.json ไว้เพราะเป็นโควตาที่จ่ายไปแล้ว แต่คีย์ของ cache คิดจาก prompt
# พอเปลี่ยนฉากทั้งฉาก prompt ก็เปลี่ยนตาม ของเก่าจึงใช้ไม่ได้สักรายการ ไม่มีเหตุให้เก็บอีก
logs/

# ผลการทดลองที่ต้องอ้างอิงในงานให้ย้ายมาไว้ที่ results/ ซึ่งเก็บลง git

# telemetry logs จากการเล่นจริงและทดสอบ
data/telemetry/*.json
data/telemetry/*.csv
!data/telemetry/.gitkeep

# Local verification scratch files
tmp/
