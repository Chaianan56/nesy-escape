# คัดลอกไฟล์นี้เป็น .env แล้วใส่คีย์จริงใน .env เท่านั้น
# ⚠️ ห้ามใส่คีย์จริงในไฟล์นี้ — .env.example ถูก commit ขึ้น git ส่วน .env ไม่ถูก
# ถ้าไม่ใส่คีย์ ระบบยังเดินได้ด้วย fallback parser แต่ห้ามใช้ผลนั้นในการทดลอง
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GPT สำรอง หลังจาก Gemini ทุกคีย์/โมเดลที่ลองใช้งานไม่สำเร็จ
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_ENABLED=true
